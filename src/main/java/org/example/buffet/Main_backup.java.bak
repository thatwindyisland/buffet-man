package org.example.buffet;

import org.example.buffet.entity.Role;
import org.example.buffet.entity.User;
import org.example.buffet.service.UserService;
import org.example.buffet.config.AppConfig;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;

public class Main {
    public static void main(String[] args) {
        try (
                var context = new AnnotationConfigApplicationContext(AppConfig.class)
        ) {
            var service = context.getBean(UserService.class);
            service.createUser(new User(
                    null,
                    "pizza_merchant",
                    null,
                    "Pizza",
                    Role.MERCHANT,
                    true
            ));

            service.createUser(new User(
                    null,
                    "admin01",
                    null,
                    "Administrator",
                    Role.ADMIN,
                    true
            ));

            System.out.println("============All Users:");
            for(User user_item : service.getAllUsers()){
                System.out.println(user_item.getDisplayName());
                System.out.println(user_item.getId());
                System.out.println(user_item.getRole());
                System.out.println(user_item.getUsername());
                System.out.println(user_item.isEnabled());
            }
            System.out.println("=========All Merchants:");
            for(User merchant : service.getAllMerchant()){
                System.out.println(merchant.getDisplayName());
            }

        }
    }
}